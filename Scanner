-- Functions
function ServerHop()
    local success, response = pcall(Request, {Url = ServersURL, Method = "GET", Headers = {["Content-Type"] = "application/json"}})

    if not success or not response or not response.Body then 
        return
    end

    local resultSuccess, result = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not resultSuccess then
        return
    end

    if resultSuccess and not result then 
        return
    end

    for i,v in pairs(result.serverIds) do 
        print(i,v)
        pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, v) end)
        task.wait(.1)
    end
end

local function dateTime()
    local OSTime = os.time()
    local Time = os.date('!*t', OSTime)
    return string.format('%d-%d-%dT%02d:%02d:%02dZ', Time.year, Time.month, Time.day, Time.hour, Time.min, Time.sec)
end

local function sendWebhook(owner, brainrot, gen)
    local description = {}

    table.insert(description, "**Generation:**\n ```"..NumberUtils:ToString(gen).."/s```")
    table.insert(description, "**Player:**\n ```"..owner.DisplayName.." (@"..owner.Name..")```")
    table.insert(description, "**JobID:**\n ```"..JobId.."```")
    table.insert(description, "**Players:**\n ```"..(#Players:GetChildren()).."/8```")

    local msg = {
        ["username"] =  "Coral",
        ["avatar_url"] = "https://img.freepik.com/premium-vector/cartoon-coral-with-green-seaweed-it_730620-830462.jpg?w=1480",
        ["content"] = (gen >= 40000000 and "@everyone" or ""),
        ["embeds"] = {
            {
                ["color"] = (gen > 40000000 and 0xfb21ff or 0x3452eb),
                ["title"] = brainrot,
                ["description"] = table.concat(description, "\n"),
                ['timestamp'] = dateTime(),
                ["footer"] = {
                    ["text"] = "Coral",
                    ["icon_url"] = "https://img.freepik.com/premium-vector/cartoon-coral-with-green-seaweed-it_730620-830462.jpg?w=1480",
                }
            },
        },
    }

    Request({Url = _S.Webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(msg)})
end

local function sendToDB(brainrot, gen)
    local data = {
        JobId = JobId,
        brainrot = brainrot,
        generation = gen,
    }

    Request({Url = WorkerURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)})
end

local function checkBrainrots()
    local plots = debug.getupvalues(PlotController.Start)[2]

    for i,v in pairs(plots) do
        local owner, data = v:GetOwner()

        if owner == Player then continue end
        if not data.AnimalList then continue end
        for i2,v2 in pairs(data.AnimalList) do 
            if type(v2) ~= "table" then continue end 
            local gen = AnimalsModule:GetGeneration(v2.Index, v2.Mutation, v2.Traits)
            if gen >= _S.MinGeneration then 
                print(`Found Brainrot: {v2.Index} | Gen: {gen}`)
                sendToDB(v2.Index, gen)
                sendWebhook(owner, v2.Index , gen)
            end
        end
    end
end

GameController:OnGameLoaded(function()
    print("Game Loaded - Checking Brainrots")
    checkBrainrots()

    task.wait(5)

    while task.wait(13) do
        pcall(function() ServerHop() end)
    end
end)
